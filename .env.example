# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WORKER_CONCURRENCY=5

# Database
DATABASE_URL=postgresql://freight:freight@localhost:5432/freight_portal?schema=public

# Redis / Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
PASSWORD_HASH_PEPPER=replace-with-a-long-random-secret

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=freight-documents
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=replace-with-local-secret
S3_FORCE_PATH_STYLE=true

# Observability
SENTRY_DSN=
LOG_LEVEL=info
