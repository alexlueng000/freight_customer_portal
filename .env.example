# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
WORKER_CONCURRENCY=5

# Database
# Change the host port if 5432 is already used locally (for example, 5433).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://freight:freight@localhost:5432/freight_portal?schema=public
SEED_DEMO_DATA=false

# Redis / Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_HASH_PEPPER=replace-with-a-long-random-secret
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password
DEMO_CUSTOMER_PASSWORD=replace-with-a-different-local-demo-password

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=freight-documents
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=replace-with-local-secret
S3_FORCE_PATH_STYLE=true

# Quote jobs
QUOTE_EXPIRY_INTERVAL_MS=60000

# Observability
SENTRY_DSN=
LOG_LEVEL=info
