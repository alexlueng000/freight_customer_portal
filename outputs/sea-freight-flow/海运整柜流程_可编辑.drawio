r=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="440" width="500" height="80" /></mxCell><mxCell id="a4" value="发货人｜生成订舱托运委托书" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="555" width="500" height="66" /></mxCell><mxCell id="a5" value="货代运营 ↔ 船公司｜申请并确认舱位&lt;br&gt;向客户提供舱位确认单" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="650" width="500" height="66" /></mxCell><mxCell id="a6" value="建立运输任务&lt;br&gt;后续进度、单证与费用持续同步" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="745" width="500" height="66" /></mxCell><mxCell id="a7" value="截止时间前是否提出取消？" style="rhombus;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="840" width="500" height="80" /></mxCell><mxCell id="a8" value="货代运营｜申请取消&lt;br&gt;船公司｜确认取消" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="965" width="250" height="66" /></mxCell><mxCell id="a9" value="货代运营｜安排提箱、拖车&lt;br&gt;准备装柜" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="965" width="250" height="66" /></mxCell><mxCell id="a10" value="取消结果同步运输任务&lt;br&gt;取消分支结束" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e9f2ff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1070" width="250" height="66" /></mxCell><mxCell id="a11" value="① 进入装柜与出口流程" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e9f2ff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="1070" width="250" height="66" /></mxCell><mxCell id="b0" value="① 接续：提箱与装柜" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e9f7f1;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="155" width="500" height="66" /></mxCell><mxCell id="b1" value="生成装运任务通知单&lt;br&gt;上柜时间、柜型、订舱号、订单号、车牌及司机电话" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="250" width="500" height="66" /></mxCell><mxCell id="b2" value="发货人｜完成装柜并提供实际装运信息&lt;br&gt;生成装箱单" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="345" width="500" height="66" /></mxCell><mxCell id="b3" value="发货人｜准备出口报关资料&lt;br&gt;报关单、商业发票、装箱单、合同、报关委托书等" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="440" width="500" height="66" /></mxCell><mxCell id="b4" value="发货人是否自行报关？" style="rhombus;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="545" width="500" height="80" /></mxCell><mxCell id="b5" value="发货人自行安排申报&lt;br&gt;配合查验（如需）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="670" width="250" height="66" /></mxCell><mxCell id="b6" value="货代运营安排申报&lt;br&gt;配合查验（如需）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="670" width="250" height="66" /></mxCell><mxCell id="b7" value="取得海关放行信息及相关单证" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="775" width="500" height="66" /></mxCell><mxCell id="b8" value="拖车运重箱至起运港码头&lt;br&gt;码头核对放行信息并安排进港" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="870" width="500" height="66" /></mxCell><mxCell id="b9" value="码头｜集装箱装船&lt;br&gt;船公司｜签发提单 B/L" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="965" width="500" height="66" /></mxCell><mxCell id="b10" value="船公司｜确认船期、执行海上运输&lt;br&gt;货代运营｜提供船期及追踪信息" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="1060" width="500" height="66" /></mxCell><mxCell id="b11" value="船公司｜发送到货通知 Arrival Notice&lt;br&gt;到港时间、船名、提单号及换单时间" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="1155" width="500" height="66" /></mxCell><mxCell id="b12" value="② 进入目的港操作" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e9f7f1;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="1250" width="500" height="66" /></mxCell><mxCell id="c0" value="② 接续：到港与通知" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2e4;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="155" width="500" height="66" /></mxCell><mxCell id="c1" value="是否由发运货代跟进目的港操作？" style="rhombus;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="250" width="500" height="80" /></mxCell><mxCell id="c2" value="发运货代负责后续操作" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="375" width="250" height="66" /></mxCell><mxCell id="c3" value="收货人自行处理&lt;br&gt;或委托目的港货代" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1540" y="375" width="250" height="66" /></mxCell><mxCell id="c4" value="换单｜正本提单或电放资料&lt;br&gt;缴纳相关费用，换取提货单 D/O" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="485" width="500" height="66" /></mxCell><mxCell id="c5" value="进口清关｜提交 D/O 及清关资料&lt;br&gt;配合查验、缴纳进口税费，取得海关放行单" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="580" width="500" height="66" /></mxCell><mxCell id="c6" value="提柜｜安排拖车，凭 D/O、海关放行单及 EIR&lt;br&gt;至码头／堆场提柜，验箱出场" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="675" width="500" height="66" /></mxCell><mxCell id="c7" value="派送｜货物送至指定地点&lt;br&gt;货代承办时生成送货任务通知单" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="770" width="500" height="66" /></mxCell><mxCell id="c8" value="由谁安排还空箱？" style="rhombus;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="865" width="500" height="80" /></mxCell><mxCell id="c9" value="货代安排还空箱&lt;br&gt;归还至指定堆场" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="990" width="250" height="66" /></mxCell><mxCell id="c10" value="收货人安排还空箱&lt;br&gt;归还至指定堆场" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1540" y="990" width="250" height="66" /></mxCell><mxCell id="c11" value="目的港实物流转完成" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2e4;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="1110" width="500" height="66" /></mxCell><mxCell id="c12" value="财务｜生成本次承办范围的费用对账单&lt;br&gt;同步运输任务；对账为原图财务终点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#b5c6d5;fontColor=#173047;" vertex="1" parent="1"><mxGeometry as="geometry" x="1290" y="1250" width="500" height="66" /></mxCell><mxCell id="notes" value="统一信息同步｜舱位／取消、拖车、进港、船期、到货、换单、清关、提柜、还箱及对账信息 → 运输任务。&lt;br&gt;这里的“运输任务”沿用原图用语，表示业务跟踪载体；同步不代表业务流程倒退或重新执行。&lt;br&gt;目的港两条分支操作步骤相同，合并展示；责任方由“是否由发运货代跟进”决定，还空箱另按实际安排分工。&lt;br&gt;财务时点：原图“不跟进目的港操作”分支可直接进入对账，不必等待收货人完成目的港流程；此处不强制串行。&lt;br&gt;理解性整理：“自行报告”按“自行报关”，“推车”按“拖车”，“价格有限期限”按“价格有效期”处理。&lt;br&gt;订舱申请与确认、海关放行措辞已按上下文顺序整理；未补充原图未覆盖的拒舱、查验异常、开票或收款流程。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacing=20;fillColor=#f3f6fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1390" width="1770" height="240" /></mxCell></root></mxGraphModel></diagram></mxfile>