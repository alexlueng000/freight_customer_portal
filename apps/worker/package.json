{
  "name": "@freight/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "lint": "node ../../node_modules/eslint/bin/eslint.js src --max-warnings=0",
    "start": "node dist/main.js",
    "test": "jest --config jest.config.cjs --runInBand --forceExit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.34.5",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.2",
    "pdfkit": "^0.20.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
