generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum UserType {
  INTERNAL
  CUSTOMER
}

enum RoleCode {
  SUPER_ADMIN
  TENANT_ADMIN
  SALES
  OPERATION
  FINANCE
  CUSTOMER_ADMIN
  CUSTOMER_USER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum MarkupType {
  NONE
  FIXED
  PERCENT
}

enum RateStatus {
  DRAFT
  ACTIVE
  EXPIRED
  INACTIVE
}

enum ChargeBasis {
  PER_CONTAINER
  PER_BL
  PER_SHIPMENT
}

enum RateImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  BOOKED
  EXPIRED
  REJECTED
  CANCELLED
}

enum BookingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CONFIRMED
  SO_RELEASED
  REJECTED
  CANCELLED
}

enum ShipmentStatus {
  PLANNED
  IN_PROGRESS
  DEPARTED
  ARRIVED
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  ACTIVE
  SUPERSEDED
  DELETED
}

model Tenant {
  id              String       @id @default(cuid())
  code            String       @unique @db.VarChar(50)
  name            String       @db.VarChar(200)
  status          TenantStatus @default(TRIAL)
  timezone        String       @default("Asia/Shanghai") @db.VarChar(100)
  defaultCurrency String       @default("USD") @db.VarChar(3)
  brandName       String?      @db.VarChar(200)
  logoUrl         String?      @db.VarChar(1000)
  customDomain    String?      @unique @db.VarChar(255)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  users                  User[]
  roles                  Role[]
  customerCompanies      CustomerCompany[]
  customerContacts       CustomerContact[]
  auditLogs              AuditLog[]
  businessNumberCounters BusinessNumberCounter[]
  refreshSessions        RefreshSession[]
  rates                  Rate[]
  rateImportJobs         RateImportJob[]
  quotes                 Quote[]
  bookings               Booking[]
  shipments              Shipment[]
  documents              Document[]
}

model RateImportJob {
  id               String           @id @default(cuid())
  tenantId         String
  originalFileName String           @db.VarChar(255)
  status           RateImportStatus @default(PENDING)
  totalRows        Int              @default(0)
  successRows      Int              @default(0)
  failedRows       Int              @default(0)
  errors           Json?
  errorMessage     String?          @db.VarChar(1000)
  createdById      String
  startedAt        DateTime?        @db.Timestamptz(3)
  completedAt      DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdById, createdAt])
}

model Rate {
  id            String     @id @default(cuid())
  tenantId      String
  rateNo        String     @db.VarChar(50)
  polCode       String     @db.VarChar(10)
  polName       String     @db.VarChar(150)
  podCode       String     @db.VarChar(10)
  podName       String     @db.VarChar(150)
  carrierCode   String     @db.VarChar(20)
  serviceName   String?    @db.VarChar(150)
  effectiveDate DateTime   @db.Date
  expiryDate    DateTime   @db.Date
  etd           DateTime?  @db.Timestamptz(3)
  transitDays   Int?
  supplierName  String?    @db.VarChar(200)
  contractNo    String?    @db.VarChar(100)
  currency      String     @db.VarChar(3)
  status        RateStatus @default(DRAFT)
  createdById   String?
  updatedById   String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  prices  RatePrice[]
  charges RateCharge[]
  quotes  Quote[]

  @@unique([tenantId, rateNo])
  @@index([tenantId, polCode, podCode, status])
  @@index([tenantId, carrierCode, effectiveDate, expiryDate])
  @@index([tenantId, expiryDate])
}

model RatePrice {
  id            String   @id @default(cuid())
  tenantId      String
  rateId        String
  containerType String   @db.VarChar(20)
  costAmount    Decimal  @db.Decimal(18, 4)
  sellAmount    Decimal? @db.Decimal(18, 4)
  currency      String   @db.VarChar(3)
  remark        String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  rate Rate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  @@unique([rateId, containerType])
  @@index([tenantId, rateId])
}

model RateCharge {
  id            String      @id @default(cuid())
  tenantId      String
  rateId        String
  chargeCode    String      @db.VarChar(30)
  chargeName    String      @db.VarChar(150)
  chargeBasis   ChargeBasis
  containerType String?     @db.VarChar(20)
  amount        Decimal     @db.Decimal(18, 4)
  currency      String      @db.VarChar(3)
  isIncluded    Boolean     @default(false)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  rate Rate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  @@index([tenantId, rateId])
  @@index([tenantId, chargeCode])
}

model User {
  id                String     @id @default(cuid())
  tenantId          String
  customerCompanyId String?
  email             String     @db.VarChar(320)
  passwordHash      String     @db.VarChar(255)
  displayName       String     @db.VarChar(150)
  userType          UserType
  status            UserStatus @default(INVITED)
  lastLoginAt       DateTime?  @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerCompany       CustomerCompany?  @relation("CustomerUsers", fields: [customerCompanyId], references: [id], onDelete: Restrict)
  userRoles             UserRole[]
  ownedCustomers        CustomerCompany[] @relation("CustomerSalesOwner")
  auditLogs             AuditLog[]        @relation("AuditActor")
  refreshSessions       RefreshSession[]
  ownedQuotes           Quote[]           @relation("QuoteSalesOwner")
  priceOverriddenQuotes Quote[]           @relation("QuotePriceOverrideBy")
  createdBookings       Booking[]         @relation("BookingCreatedBy")
  updatedBookings       Booking[]         @relation("BookingUpdatedBy")
  createdShipments      Shipment[]        @relation("ShipmentCreatedBy")
  uploadedDocuments     Document[]        @relation("DocumentUploadedBy")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, customerCompanyId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  code        RoleCode
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  roles RolePermission[]
}

model UserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)
  assignedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model CustomerCompany {
  id                 String         @id @default(cuid())
  tenantId           String
  code               String         @db.VarChar(50)
  name               String         @db.VarChar(200)
  shortName          String?        @db.VarChar(100)
  countryCode        String?        @db.VarChar(2)
  taxId              String?        @db.VarChar(100)
  creditLimit        Decimal?       @db.Decimal(18, 4)
  paymentTermDays    Int?
  defaultMarkupType  MarkupType     @default(NONE)
  defaultMarkupValue Decimal?       @db.Decimal(18, 4)
  salesOwnerId       String?
  status             CustomerStatus @default(ACTIVE)
  createdById        String?
  updatedById        String?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salesOwner    User?             @relation("CustomerSalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  contacts      CustomerContact[]
  customerUsers User[]            @relation("CustomerUsers")
  quotes        Quote[]
  bookings      Booking[]
  shipments     Shipment[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, salesOwnerId])
  @@index([tenantId, status])
}

model CustomerContact {
  id                String   @id @default(cuid())
  tenantId          String
  customerCompanyId String
  name              String   @db.VarChar(150)
  email             String?  @db.VarChar(320)
  phone             String?  @db.VarChar(50)
  roleTitle         String?  @db.VarChar(100)
  isPrimary         Boolean  @default(false)
  isBookingContact  Boolean  @default(false)
  isDocumentContact Boolean  @default(false)
  createdById       String?
  updatedById       String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerCompany CustomerCompany @relation(fields: [customerCompanyId], references: [id], onDelete: Restrict)

  @@index([tenantId, customerCompanyId])
  @@index([tenantId, email])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  entityType  String   @db.VarChar(100)
  entityId    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  beforeData  Json?
  afterData   Json?
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(1000)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model BusinessNumberCounter {
  id        String   @id @default(cuid())
  tenantId  String
  type      String   @db.VarChar(30)
  yearMonth String   @db.VarChar(6)
  value     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, type, yearMonth])
  @@index([tenantId, type])
}

model RefreshSession {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  familyId      String    @db.VarChar(50)
  tokenHash     String    @unique @db.VarChar(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?   @db.VarChar(100)
  replacedById  String?
  ipAddress     String?   @db.VarChar(64)
  userAgent     String?   @db.VarChar(1000)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshSession?  @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshSession[] @relation("SessionRotation")

  @@index([tenantId, userId, expiresAt])
  @@index([tenantId, familyId])
}

model Quote {
  id                  String      @id @default(cuid())
  tenantId            String
  quoteNo             String      @db.VarChar(50)
  customerCompanyId   String
  salesOwnerId        String?
  sourceRateId        String?
  status              QuoteStatus @default(DRAFT)
  polCode             String      @db.VarChar(10)
  podCode             String      @db.VarChar(10)
  carrierCode         String?     @db.VarChar(20)
  etd                 DateTime?   @db.Timestamptz(3)
  validUntil          DateTime    @db.Date
  currency            String      @db.VarChar(3)
  subtotal            Decimal     @db.Decimal(18, 4)
  totalAmount         Decimal     @db.Decimal(18, 4)
  acceptedAt          DateTime?   @db.Timestamptz(3)
  bookedAt            DateTime?   @db.Timestamptz(3)
  priceOverriddenAt   DateTime?   @db.Timestamptz(3)
  priceOverriddenById String?
  priceOverrideReason String?     @db.VarChar(500)
  version             Int         @default(1)
  createdById         String?
  updatedById         String?
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer          CustomerCompany @relation(fields: [customerCompanyId], references: [id], onDelete: Restrict)
  salesOwner        User?           @relation("QuoteSalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  priceOverriddenBy User?           @relation("QuotePriceOverrideBy", fields: [priceOverriddenById], references: [id], onDelete: SetNull)
  sourceRate        Rate?           @relation(fields: [sourceRateId], references: [id], onDelete: SetNull)
  items             QuoteItem[]
  bookings          Booking[]

  @@unique([tenantId, quoteNo])
  @@index([tenantId, customerCompanyId, status])
  @@index([tenantId, validUntil])
  @@index([tenantId, sourceRateId])
  @@index([tenantId, priceOverriddenById])
}

model QuoteItem {
  id                String   @id @default(cuid())
  tenantId          String
  quoteId           String
  chargeCode        String   @db.VarChar(30)
  chargeName        String   @db.VarChar(150)
  containerType     String?  @db.VarChar(20)
  quantity          Decimal  @default(1) @db.Decimal(18, 4)
  unitPrice         Decimal  @db.Decimal(18, 4)
  originalUnitPrice Decimal? @db.Decimal(18, 4)
  amount            Decimal  @db.Decimal(18, 4)
  currency          String   @db.VarChar(3)
  costAmount        Decimal? @db.Decimal(18, 4)
  sortOrder         Int      @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
}

model Booking {
  id                  String        @id @default(cuid())
  tenantId            String
  bookingNo           String        @db.VarChar(50)
  quoteId             String?
  customerCompanyId   String
  status              BookingStatus @default(DRAFT)
  polCode             String        @db.VarChar(10)
  podCode             String        @db.VarChar(10)
  carrierCode         String?       @db.VarChar(20)
  etd                 DateTime?     @db.Timestamptz(3)
  commodity           String?       @db.VarChar(300)
  packages            Int?
  grossWeight         Decimal?      @db.Decimal(18, 4)
  volumeCbm           Decimal?      @db.Decimal(18, 4)
  isDangerousGoods    Boolean       @default(false)
  shipperName         String?       @db.VarChar(200)
  shipperAddress      String?       @db.VarChar(1000)
  bookingContactName  String?       @db.VarChar(150)
  bookingContactEmail String?       @db.VarChar(320)
  bookingContactPhone String?       @db.VarChar(50)
  lastStatusRemark    String?       @db.VarChar(500)
  submittedAt         DateTime?     @db.Timestamptz(3)
  underReviewAt       DateTime?     @db.Timestamptz(3)
  confirmedAt         DateTime?     @db.Timestamptz(3)
  rejectedAt          DateTime?     @db.Timestamptz(3)
  cancelledAt         DateTime?     @db.Timestamptz(3)
  createdById         String?
  updatedById         String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quote             Quote?                    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customer          CustomerCompany           @relation(fields: [customerCompanyId], references: [id], onDelete: Restrict)
  createdBy         User?                     @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?                     @relation("BookingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  containerRequests BookingContainerRequest[]
  shipments         Shipment[]
  documents         Document[]

  @@unique([tenantId, bookingNo])
  @@index([tenantId, customerCompanyId, status])
  @@index([tenantId, quoteId])
  @@index([tenantId, createdAt])
}

model BookingContainerRequest {
  id                 String   @id @default(cuid())
  tenantId           String
  bookingId          String
  containerType      String   @db.VarChar(20)
  quantity           Int
  weightPerContainer Decimal? @db.Decimal(18, 4)
  remark             String?  @db.VarChar(500)
  sortOrder          Int      @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, containerType])
  @@index([tenantId, bookingId])
}

model Shipment {
  id                String         @id @default(cuid())
  tenantId          String
  shipmentNo        String         @db.VarChar(50)
  bookingId         String
  customerCompanyId String
  status            ShipmentStatus @default(PLANNED)
  carrierCode       String?        @db.VarChar(20)
  vessel            String?        @db.VarChar(100)
  voyage            String?        @db.VarChar(50)
  polCode           String         @db.VarChar(10)
  podCode           String         @db.VarChar(10)
  etd               DateTime?      @db.Timestamptz(3)
  eta               DateTime?      @db.Timestamptz(3)
  createdById       String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer  CustomerCompany @relation(fields: [customerCompanyId], references: [id], onDelete: Restrict)
  createdBy User?           @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents Document[]

  @@unique([tenantId, shipmentNo])
  @@index([tenantId, customerCompanyId, status])
  @@index([tenantId, bookingId])
}

model Document {
  id               String         @id @default(cuid())
  tenantId         String
  bookingId        String?
  shipmentId       String?
  documentType     String         @db.VarChar(50)
  objectKey        String         @unique @db.VarChar(1000)
  originalFilename String         @db.VarChar(255)
  mimeType         String         @db.VarChar(150)
  sizeBytes        Int
  version          Int            @default(1)
  customerVisible  Boolean        @default(false)
  status           DocumentStatus @default(ACTIVE)
  uploadedById     String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  uploadedBy User?     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, bookingId, documentType, version])
  @@index([tenantId, shipmentId, documentType, status])
  @@index([tenantId, bookingId, documentType, status])
}
